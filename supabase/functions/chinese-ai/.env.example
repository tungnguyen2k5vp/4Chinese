# Server-only. No real secrets here. Do not copy provider keys into Expo env/config.
AI_RUNTIME_MODE=DISABLED
AI_BUDGET_MODE=FREE_ONLY
AI_ALLOW_PAID=false
AI_ALLOW_AUTO_BILLING=false
AI_DEV_USER_IDS=
# Optional, separate allowlist for content draft generation; must also be in AI_DEV_USER_IDS.
AI_ADMIN_USER_IDS=
AI_FREE_VERIFICATIONS=[]
AI_DEV_RPM=4
AI_DEV_DAILY_CAP=20
AI_DEV_SESSION_CAP=8
GEMINI_API_KEY=
GROQ_API_KEY=
# OpenRouter and OpenAI direct remain blocked by the registry/policy.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
