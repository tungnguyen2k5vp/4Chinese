{
  "expo": {
    "name": "4Chinese",
    "slug": "4chinese",
    "version": "0.1.55",
    "orientation": "portrait",
    "icon": "./assets/images/hanzi-icon.png",
    "scheme": "4chinese",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/hanzi-icon.png",
      "bundleIdentifier": "com.tungnguyen2k5vp.fourchinese"
    },
    "android": {
      "package": "com.tungnguyen2k5vp.fourchinese",
      "versionCode": 57,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2457D6",
        "foregroundImage": "./assets/images/hanzi-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/hanzi-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2457D6",
          "image": "./assets/images/hanzi-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cho phép 4Chinese dùng micro để nhận diện cách đọc tiếng Trung.",
          "speechRecognitionPermission": "Cho phép 4Chinese nhận diện giọng nói tiếng Trung.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép 4Chinese chọn ảnh minh họa cho từ vựng của bạn.",
          "microphonePermission": "Cho phép 4Chinese dùng micro khi ghi âm phát âm tiếng Trung."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Cho phép 4Chinese dùng micro để ghi âm và AI chấm phát âm tiếng Trung.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
